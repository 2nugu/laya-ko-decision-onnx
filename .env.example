# Copy to .env and source it, or export these directly.
# All are optional — defaults are repo-relative and a fresh clone works without them.

# Where this repo lives (default: the directory containing scripts/)
# export LAYA_KO_ROOT=/path/to/laya-ko

# Caches and the built training set (default: $LAYA_KO_ROOT/data)
# export LAYA_KO_DATA=/path/to/data

# Checkpoints and ONNX builds (default: $LAYA_KO_ROOT/models)
# export LAYA_KO_MODELS=/path/to/models

# Local eval corpora: expects kmmlu/ mmlu/ jcommonsenseqa/ underneath.
# Benchmarks that need these are skipped if absent.
# export LAYA_KO_EVAL_DIR=/path/to/eval_datasets

# AI-Hub jsonl corpora (not redistributed). Needed only for ko_culture and for the
# AI-Hub portion of the training mixture.
# export LAYA_KO_AIHUB_DIR=/path/to/korean_datasets
